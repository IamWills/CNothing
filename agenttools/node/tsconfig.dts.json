{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "../core/src",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../core/src/**/*.ts"],
  "exclude": ["../core/src/__tests__"]
}
