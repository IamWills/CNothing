# Runtime
PORT=3021
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/cnothing

# Required: 32 random bytes encoded as base64url.
# Generate with: bun run generate-secrets
KEYSERVICE_MASTER_KEY=

# Required service credential for bootstrap, recovery, and trusted automation.
# Not a human Console login. CN_SERVICE_TOKEN is accepted as an alias.
KEYSERVICE_BEARER_TOKEN=
# CN_SERVICE_TOKEN=

# Public origins used for OAuth callbacks and approval links.
KEYSERVICE_PUBLIC_URL=https://cnothing.com
KEYSERVICE_CONSOLE_URL=https://cnothing.com
KEYSERVICE_USER_SESSION_TTL_SECONDS=86400

# Browser sign-in and GitHub account connections.
KEYSERVICE_GITHUB_OAUTH_CLIENT_ID=
KEYSERVICE_GITHUB_OAUTH_CLIENT_SECRET=

# Optional built-in OAuth providers.
KEYSERVICE_GOOGLE_OAUTH_CLIENT_ID=
KEYSERVICE_GOOGLE_OAUTH_CLIENT_SECRET=
KEYSERVICE_MICROSOFT_OAUTH_CLIENT_ID=
KEYSERVICE_MICROSOFT_OAUTH_CLIENT_SECRET=
KEYSERVICE_SLACK_OAUTH_CLIENT_ID=
KEYSERVICE_SLACK_OAUTH_CLIENT_SECRET=
KEYSERVICE_NOTION_OAUTH_CLIENT_ID=
KEYSERVICE_NOTION_OAUTH_CLIENT_SECRET=

# iOS authenticator push. Keep the .p8 file outside the repository.
# Example path after all three required APNs values are available:
# KEYSERVICE_APNS_KEY_PATH=/etc/cnothing/apns/AuthKey_KEYID.p8
KEYSERVICE_APNS_KEY_PATH=
KEYSERVICE_APNS_KEY_ID=
KEYSERVICE_APNS_TEAM_ID=
KEYSERVICE_APNS_BUNDLE_ID=com.molobaya.app.cnothing

# Abuse prevention.
KEYSERVICE_RATE_LIMIT_PER_MINUTE=120
KEYSERVICE_REPLAY_TTL_SECONDS=300
