{
  "sourceLanguage" : "en",
  "strings" : {
    "Pair as Approval Device" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "绑定为审批设备" } }
      }
    },
    "Sign in to the CNothing Console on the web, open the Devices page to generate a pairing QR code, then scan it here. You'll receive and approve agent authorization requests on this phone, just like Microsoft Authenticator." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 CNothing Console（网页端登录后）打开 Devices 页生成配对二维码，扫码即可绑定。之后就能像 Microsoft Authenticator 一样在手机上接收并批准 agent 的授权请求。" } }
      }
    },
    "Scan QR Code to Pair" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "扫描二维码绑定" } }
      }
    },
    "This device cannot scan QR codes. Enter the pairing code manually." : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此设备不支持相机扫码，请手动输入配对码。" } }
      }
    },
    "Or enter the pairing code manually" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "或手动输入配对码" } }
      }
    },
    "e.g. K7PQ2MXR" : {
      "localizations" : {
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "例如 K7PQ2MXR" } }
      }
    },
