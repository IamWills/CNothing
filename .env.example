# Network
PORT=3021

# PostgreSQL connection string used by keyservice migrations and runtime
DATABASE_URL=postgresql://username:password@127.0.0.1:5432/keyservice

# 32-byte master key encoded as base64 or base64url
# Generate with: bun run generate-secrets
KEYSERVICE_MASTER_KEY=

# RSA private key path used by keyservice to decrypt auth/data/query envelopes
# Generate with: bun run generate-secrets
KEYSERVICE_AUTHAI_PRIVATE_KEY_PATH=.local-keys/authai-private-key.pem

# Optional public key path. If omitted, keyservice derives the public key from the private key.
KEYSERVICE_AUTHAI_PUBLIC_KEY_PATH=.local-keys/authai-public-key.pem

# One-time challenge TTL in seconds
KEYSERVICE_CHALLENGE_TTL_SECONDS=300

# Reserved for management/admin interfaces and Console admin API access.
KEYSERVICE_BEARER_TOKEN=

# User session TTL in seconds (default 86400 = 24h)
KEYSERVICE_USER_SESSION_TTL_SECONDS=86400

# One-time login token TTL in seconds (default 900 = 15m)
KEYSERVICE_USER_LOGIN_TOKEN_TTL_SECONDS=900

# Console URL used to build OAuth-style approval links for agents
KEYSERVICE_CONSOLE_URL=http://127.0.0.1:3000

# v1 API sunset date (ISO 8601 date, used in Deprecation/Sunset headers)
KEYSERVICE_V1_SUNSET_DATE=2026-12-17

# Public API base URL used for OAuth callbacks and v2 bootstrap (defaults to KEYSERVICE_CONSOLE_URL origin)
KEYSERVICE_PUBLIC_URL=http://127.0.0.1:3021

# Auto-create platform connector, capabilities, and default agent on startup (set 0 to disable)
KEYSERVICE_V2_AUTO_BOOTSTRAP=1

# Auto-grant low-risk capabilities to users after GitHub/OIDC login (set 0 to disable)
KEYSERVICE_V2_AUTO_GRANT_LOW_RISK=1

# Default built-in agent name created by bootstrap
KEYSERVICE_PLATFORM_AGENT_NAME=cnothing-platform-agent

# GitHub OAuth App credentials for Console user sign-in and v2.5 OAuth provider
KEYSERVICE_GITHUB_OAUTH_CLIENT_ID=
KEYSERVICE_GITHUB_OAUTH_CLIENT_SECRET=

# v2.5 built-in OAuth provider credentials (optional — configure per provider)
KEYSERVICE_GOOGLE_OAUTH_CLIENT_ID=
KEYSERVICE_GOOGLE_OAUTH_CLIENT_SECRET=
KEYSERVICE_MICROSOFT_OAUTH_CLIENT_ID=
KEYSERVICE_MICROSOFT_OAUTH_CLIENT_SECRET=
KEYSERVICE_SLACK_OAUTH_CLIENT_ID=
KEYSERVICE_SLACK_OAUTH_CLIENT_SECRET=
KEYSERVICE_NOTION_OAUTH_CLIENT_ID=
KEYSERVICE_NOTION_OAUTH_CLIENT_SECRET=

# GitHub PAT for platform connector GitHub API capabilities (list repos, create issues, etc.)
KEYSERVICE_GITHUB_TOKEN=

# Optional default webhook URL for webhook.notify capability
KEYSERVICE_WEBHOOK_DEFAULT_URL=

# Searchengine (search.morethinkings.com) v2 connector — no KV required
KEYSERVICE_SEARCH_API_URL=https://search.morethinkings.com
# Auto-register search connector on startup when URL is set (set 0 to disable)
KEYSERVICE_SEARCH_AUTO_BOOTSTRAP=1

# Enable admin-only E2E internal endpoints (/v2/internal/e2e/*) for automated tests
KEYSERVICE_E2E_INTERNAL=0

# Override GitHub API base URL (used by E2E mock server)
# KEYSERVICE_GITHUB_API_BASE_URL=http://127.0.0.1:3199
